# VK Post Reposting Bot - Environment Variables

# Flask/FastAPI Configuration
FLASK_ENV=development
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=8000

# VK API Configuration
VK_USER_TOKEN=your_user_token_here
VK_GROUP_TOKEN=your_group_token_here
VK_GROUP_ID=123456789
VK_API_VERSION=5.131

# Application Settings
APP_NAME=VK Post Reposting Bot
APP_VERSION=1.0.0
APP_DESCRIPTION=Automated VK post reposting system

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# Storage
STORAGE_DIR=storage
DOWNLOADS_DIR=storage/downloaded_posts
BACKUPS_DIR=storage/backups
CONFIG_FILE=config.json

# Processing
ANTIPLAGIATA_ENABLED=true
ANTIPLAGIATA_TYPE=local
ADD_HASHTAGS=true

# Filters
ENABLE_AUTO_FILTERS=true
MIN_CONTENT_LENGTH=50

# Download Settings
POSTS_TO_DOWNLOAD=100
BATCH_SIZE=10
DELAY_BETWEEN_REQUESTS=1
CHECK_DUPLICATES=true

# Publishing Settings
POSTS_TO_PUBLISH=50
PUBLISH_DELAY=3600
SCHEDULE_ENABLED=true
SCHEDULE_TIME=02:00

# Database (if using)
DATABASE_URL=sqlite:///./bot.db

# API Keys (for external services)
OPENAI_API_KEY=
YANDEX_API_KEY=
